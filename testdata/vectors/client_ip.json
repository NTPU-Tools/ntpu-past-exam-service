{
  "_note": "Captured from the legacy backend for regression tests.",
  "cases": [
    {
      "name": "proxy headers not trusted",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "false",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "198.51.100.10",
      "expected": "10.0.0.8"
    },
    {
      "name": "no trusted cidrs configured",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "",
      "peer": "10.0.0.8",
      "x_forwarded_for": "198.51.100.10",
      "expected": "10.0.0.8"
    },
    {
      "name": "peer is not a trusted proxy",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "203.0.113.9",
      "x_forwarded_for": "198.51.100.10",
      "expected": "203.0.113.9"
    },
    {
      "name": "single forwarded hop",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "198.51.100.10",
      "expected": "198.51.100.10"
    },
    {
      "name": "first untrusted from the right",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8,192.0.2.0/24",
      "peer": "10.0.0.8",
      "x_forwarded_for": "6.6.6.6, 198.51.100.10, 192.0.2.20",
      "expected": "198.51.100.10"
    },
    {
      "name": "every hop trusted falls back to peer",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "10.1.1.1, 10.2.2.2",
      "expected": "10.0.0.8"
    },
    {
      "name": "invalid forwarded entry falls back to peer",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "198.51.100.10, not-an-ip",
      "expected": "10.0.0.8"
    },
    {
      "name": "empty forwarded header",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "",
      "expected": "10.0.0.8"
    },
    {
      "name": "missing forwarded header",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": null,
      "expected": "10.0.0.8"
    },
    {
      "name": "blank entries are ignored",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": " , 198.51.100.7 ,",
      "expected": "198.51.100.7"
    },
    {
      "name": "ipv6 peer and client",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "::1/128",
      "peer": "::1",
      "x_forwarded_for": "2001:db8::1",
      "expected": "2001:db8::1"
    },
    {
      "name": "ipv4-mapped peer does not match ipv4 cidr",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "::ffff:10.0.0.1",
      "x_forwarded_for": "198.51.100.10",
      "expected": "::ffff:10.0.0.1"
    },
    {
      "name": "invalid cidr entries are ignored",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "bogus,10.0.0.0/8",
      "peer": "10.0.0.8",
      "x_forwarded_for": "198.51.100.10",
      "expected": "198.51.100.10"
    },
    {
      "name": "host bits in cidr are accepted",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.5/8",
      "peer": "10.9.9.9",
      "x_forwarded_for": "198.51.100.10",
      "expected": "198.51.100.10"
    },
    {
      "name": "non-ip peer",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "true",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "10.0.0.0/8",
      "peer": "testclient",
      "x_forwarded_for": "198.51.100.10",
      "expected": "testclient"
    },
    {
      "name": "trusted flag spelled yes",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": "yes",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "127.0.0.0/8",
      "peer": "127.0.0.1",
      "x_forwarded_for": "198.51.100.11",
      "expected": "198.51.100.11"
    },
    {
      "name": "trusted flag with surrounding spaces is false",
      "AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS": " true ",
      "AUTH_RATE_LIMIT_TRUSTED_PROXY_CIDRS": "127.0.0.0/8",
      "peer": "127.0.0.1",
      "x_forwarded_for": "198.51.100.12",
      "expected": "127.0.0.1"
    }
  ]
}
